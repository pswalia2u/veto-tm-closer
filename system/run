#!/usr/bin/env python3
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from veto.emit import run_folder

if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.stderr.write("usage: run <institution_folder> <output_file>\n")
        sys.exit(2)
    run_folder(sys.argv[1], sys.argv[2])
